+    // AI Chat
+    var _blogId = /*[[${blog.id}]]*/ 0;
+
+    function toggleAiChat() {
+        var panel = document.getElementById('ai-chat-panel');
+        var bubble = document.getElementById('ai-chat-bubble');
+        if (panel.style.display === 'none') {
+            panel.style.display = 'flex';
+            bubble.style.display = 'none';
+            document.getElementById('ai-chat-input').focus();
+        } else {
+            panel.style.display = 'none';
+            bubble.style.display = 'flex';
+        }
+    }
+
+    function sendAiChat() {
+        var input = document.getElementById('ai-chat-input');
+        var question = input.value.trim();
+        if (!question) return;
+
+        var messages = document.getElementById('ai-chat-messages');
+        // User message
+        var userDiv = document.createElement('div');
+        userDiv.className = 'ai-chat-msg user-msg';
+        userDiv.textContent = question;
+        messages.appendChild(userDiv);
+        input.value = '';
+        messages.scrollTop = messages.scrollHeight;
+
+        // Loading
+        var loadDiv = document.createElement('div');
+        loadDiv.className = 'ai-chat-msg ai-msg ai-loading';
+        loadDiv.innerHTML = '<span class="ai-dots"><span>.</span><span>.</span><span>.</span></span> 思考中';
+        messages.appendChild(loadDiv);
+        messages.scrollTop = messages.scrollHeight;
+
+        var sendBtn = document.getElementById('ai-chat-send');
+        sendBtn.disabled = true;
+        sendBtn.textContent = '...';
+
+        $.ajax({
+            url: '/api/ai/chat',
+            type: 'POST',
+            data: { blogId: _blogId, question: question },
+            success: function(res) {
+                loadDiv.remove();
+                var aiDiv = document.createElement('div');
+                aiDiv.className = 'ai-chat-msg ai-msg';
+                aiDiv.textContent = (res && res.data) ? res.data : (res && res.message ? res.message : '抱歉，暂时无法回答');
+                messages.appendChild(aiDiv);
+                messages.scrollTop = messages.scrollHeight;
+            },
+            error: function() {
+                loadDiv.remove();
+                var errDiv = document.createElement('div');
+                errDiv.className = 'ai-chat-msg ai-msg';
+                errDiv.textContent = '网络错误，请稍后再试';
+                messages.appendChild(errDiv);
+                messages.scrollTop = messages.scrollHeight;
+            },
+            complete: function() {
+                sendBtn.disabled = false;
+                sendBtn.textContent = '发送';
+            }
+        });
+    }
+
+    // Check AI status and hide chat if disabled
+    $.get('/api/ai/status', function(res) {
+        if (!res || !res.data || !res.data.enabled) {
+            var widget = document.getElementById('ai-chat-widget');
+            if (widget) widget.style.display = 'none';
+        }
+    });
+
+    // Generate TOC from article headings
+    (function() {
+        var content = document.getElementById('blogContent');
+        var tocList = document.getElementById('tocList');
+        var tocCard = document.getElementById('sidebarToc');
+        if (!content || !tocList) return;
+        var headings = content.querySelectorAll('h1,h2,h3,h4');
+        if (headings.length === 0) {
+            if (tocCard) tocCard.style.display = 'none';
+            return;
+        }
+        var html = '';
+        for (var i = 0; i < headings.length; i++) {
+            var h = headings[i];
+            var id = 'heading-' + i;
+            h.id = id;
+            var level = parseInt(h.tagName.charAt(1));
+            var indent = Math.max(0, level - 2) * 16;
+            html += '<a href="#' + id + '" class="toc-item" style="padding-left:' + indent + 'px;">' + h.textContent + '</a>';
+        }
+        tocList.innerHTML = html;
+    })();
+
 </script>
 
 
